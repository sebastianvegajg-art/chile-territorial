# Configuración propuesta para ejecución local. Completar en .env fuera de Git.
DATABASE_URL=
CT_LOTE_OFICIAL=
BCCH_API_URL=https://si3.bcentral.cl/SieteRestWS/SieteRestWS.ashx
BCCH_API_TOKEN=
BCCH_API_USER=
BCCH_API_PASS=
DATA_DIR=./data
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Producción (Opción 1): orígenes permitidos por CORS (separados por coma) en el backend FastAPI
CT_CORS_ORIGINS=https://tu-sitio.netlify.app
# En el frontend (Netlify / Cloudflare Pages), si no usas proxy /api/*, define VITE_API_BASE=https://tu-api.onrender.com (nunca pongas tokens aquí)
