{
  "openapi": "3.1.0",
  "info": {
    "title": "Chile Territorial · PIB",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/territorios": {
      "get": {
        "operationId": "territorios",
        "description": "Devuelve Chile y las 16 regiones con su vigencia.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Consulta exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Territorio"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/publicaciones": {
      "get": {
        "operationId": "publicaciones",
        "description": "Devuelve publicaciones aprobadas de más nueva a más antigua.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Consulta exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Publicacion"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pib": {
      "get": {
        "operationId": "pib",
        "description": "Consulta un corte fijo, con orden ascendente por año y código territorial.",
        "parameters": [
          {
            "name": "territorios",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(CL|0[1-9]|1[0-6])$"
              },
              "minItems": 1,
              "maxItems": 17,
              "uniqueItems": true
            },
            "style": "form",
            "explode": true
          },
          {
            "name": "anio_desde",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 2013,
              "maximum": 9999
            }
          },
          {
            "name": "anio_hasta",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 2013,
              "maximum": 9999
            }
          },
          {
            "name": "valoracion",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "real",
                "nominal"
              ]
            }
          },
          {
            "name": "metrica",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "nivel",
                "crecimiento",
                "participacion"
              ],
              "default": "nivel"
            }
          },
          {
            "name": "publicacion",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resultados"
                }
              }
            },
            "headers": {
              "X-Publicacion": {
                "description": "Identificador del corte utilizado incluso cuando la consulta no devuelve filas.",
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Publicación inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Filtros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/pib.csv": {
      "get": {
        "operationId": "pibCsv",
        "description": "Exporta todas las filas del filtro en UTF-8 y en el mismo orden, sin paginación. Incluye cabecera y publicación por fila.",
        "parameters": [
          {
            "name": "territorios",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(CL|0[1-9]|1[0-6])$"
              },
              "minItems": 1,
              "maxItems": 17,
              "uniqueItems": true
            },
            "style": "form",
            "explode": true
          },
          {
            "name": "anio_desde",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 2013,
              "maximum": 9999
            }
          },
          {
            "name": "anio_hasta",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 2013,
              "maximum": 9999
            }
          },
          {
            "name": "valoracion",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "real",
                "nominal"
              ]
            }
          },
          {
            "name": "metrica",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "nivel",
                "crecimiento",
                "participacion"
              ],
              "default": "nivel"
            }
          },
          {
            "name": "publicacion",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta exitosa",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "description": "Cabecera: id,territorio,anio,metrica,valoracion,valor,unidad,anio_referencia,estado,clase,publicacion"
                }
              }
            },
            "headers": {
              "X-Publicacion": {
                "description": "Identificador del corte utilizado incluso cuando la consulta no devuelve filas.",
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Publicación inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Filtros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/observaciones/{id}/procedencia": {
      "get": {
        "operationId": "procedencia",
        "description": "Devuelve linaje vinculado al corte de la observación.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Procedencia"
                }
              }
            }
          },
          "404": {
            "description": "Observación inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Observacion": {
        "type": "object",
        "required": [
          "id",
          "territorio",
          "anio",
          "metrica",
          "valoracion",
          "valor",
          "unidad",
          "anio_referencia",
          "estado",
          "clase",
          "publicacion"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "territorio": {
            "type": "string",
            "pattern": "^(CL|0[1-9]|1[0-6])$"
          },
          "anio": {
            "type": "integer",
            "minimum": 2013,
            "maximum": 9999
          },
          "metrica": {
            "type": "string",
            "enum": [
              "nivel",
              "crecimiento",
              "participacion"
            ]
          },
          "valoracion": {
            "type": "string",
            "enum": [
              "real",
              "nominal"
            ]
          },
          "valor": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "unidad": {
            "type": "string",
            "minLength": 1
          },
          "anio_referencia": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 2013,
                "maximum": 9999
              },
              {
                "type": "null"
              }
            ]
          },
          "estado": {
            "type": "string",
            "enum": [
              "informado",
              "preliminar",
              "faltante",
              "suprimido",
              "no_aplicable",
              "error"
            ]
          },
          "clase": {
            "type": "string",
            "enum": [
              "oficial",
              "estimacion",
              "prueba",
              "no_disponible"
            ]
          },
          "publicacion": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "estado": {
                  "type": "string",
                  "enum": [
                    "informado",
                    "preliminar"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "valor": {
                  "type": "string"
                },
                "clase": {
                  "type": "string",
                  "enum": [
                    "oficial",
                    "estimacion",
                    "prueba"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "valor": {
                  "type": "null"
                },
                "clase": {
                  "const": "no_disponible"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "valoracion": {
                  "const": "nominal"
                }
              }
            },
            "then": {
              "properties": {
                "anio_referencia": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "metrica": {
                  "const": "crecimiento"
                }
              }
            },
            "then": {
              "properties": {
                "valoracion": {
                  "const": "real"
                },
                "unidad": {
                  "const": "%"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "metrica": {
                  "const": "participacion"
                }
              }
            },
            "then": {
              "properties": {
                "valoracion": {
                  "const": "nominal"
                },
                "unidad": {
                  "const": "%"
                }
              }
            }
          }
        ]
      },
      "Procedencia": {
        "type": "object",
        "required": [
          "observacion",
          "publicacion",
          "serie_bde",
          "artefacto",
          "selector",
          "formula_version",
          "insumos",
          "motivo"
        ],
        "additionalProperties": false,
        "properties": {
          "observacion": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "publicacion": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "serie_bde": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "artefacto": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "selector": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "formula_version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "insumos": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "motivo": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Publicacion": {
        "type": "object",
        "required": [
          "id",
          "fecha",
          "estado",
          "fuente",
          "cobertura",
          "cambios"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "estado": {
            "type": "string",
            "enum": [
              "aprobada",
              "prueba"
            ]
          },
          "fuente": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "cobertura": {
            "type": "object",
            "required": [
              "esperadas",
              "disponibles"
            ],
            "additionalProperties": false,
            "properties": {
              "esperadas": {
                "type": "integer",
                "minimum": 0
              },
              "disponibles": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "cambios": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Territorio": {
        "type": "object",
        "required": [
          "codigo",
          "nombre",
          "nivel",
          "vigente_desde",
          "vigente_hasta"
        ],
        "additionalProperties": false,
        "properties": {
          "codigo": {
            "type": "string",
            "pattern": "^(CL|0[1-9]|1[0-6])$"
          },
          "nombre": {
            "type": "string",
            "minLength": 1
          },
          "nivel": {
            "type": "string",
            "enum": [
              "nacional",
              "regional"
            ]
          },
          "vigente_desde": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "vigente_hasta": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "codigo",
          "mensaje"
        ],
        "additionalProperties": false,
        "properties": {
          "codigo": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "mensaje": {
            "type": "string"
          }
        }
      },
      "Resultados": {
        "type": "object",
        "required": [
          "publicacion",
          "pagina",
          "limite",
          "total",
          "datos"
        ],
        "additionalProperties": false,
        "properties": {
          "publicacion": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "pagina": {
            "type": "integer",
            "minimum": 1
          },
          "limite": {
            "type": "integer",
            "minimum": 1
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "datos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Observacion"
            }
          }
        }
      }
    }
  }
}
